<Window x:Class="BlueTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BlueTools"
        xmlns:vm="clr-namespace:BlueTools.ViewModels"
        xmlns:views="clr-namespace:BlueTools.Views"
        mc:Ignorable="d"
        Title="BlueTools - Bluetooth Manager" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Стиль для кнопок навигации -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E5E5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Конвертер для определения активной страницы -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.DataContext>
            <vm:MainViewModel/>
        </Grid.DataContext>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель навигации (Navbar) -->
        <Border Grid.Column="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок приложения -->
                <Border Grid.Row="0" Background="#007ACC" Padding="20,15">
                    <TextBlock Text="🔵 BlueTools" 
                               Foreground="White" 
                               FontSize="20" 
                               FontWeight="Bold"/>
                </Border>

                <!-- Кнопки навигации -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <!-- Кнопка Bluetooth страницы -->
                    <Button Content="📡 Bluetooth" 
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Bluetooth"
                            Style="{StaticResource NavButtonStyle}"/>
                    
                    <!-- Пример добавления новой страницы (раскомментируйте при необходимости) -->
                    <!--
                    <Button Content="⚙️ Настройки" 
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Settings"
                            Style="{StaticResource NavButtonStyle}"/>
                    -->
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основная область контента -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок текущей страницы -->
            <Border Grid.Row="0" Background="White" Padding="20,15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding CurrentTitle}" 
                           FontSize="24" 
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Область для страниц -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:BluetoothPageViewModel}">
                        <views:BluetoothPageView DataContext="{Binding}"/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
